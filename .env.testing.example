# =========================================================
# Contoh konfigurasi TEST
# =========================================================
# Salin file ini menjadi `.env.testing`, lalu isi kredensial Anda:
#
#     cp .env.testing.example .env.testing
#
# File `.env.testing` TIDAK ikut ter-commit ke GitHub (lihat .gitignore),
# sehingga password Anda tetap aman.
#
# Database testing harus TERPISAH dari database aplikasi, karena PHPUnit
# akan MENGHAPUS seluruh isi tabel (RefreshDatabase).
# =========================================================

APP_NAME="SPK & Kontrol Keuangan (Testing)"
APP_ENV=testing

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bks_test
DB_USERNAME=root
DB_PASSWORD=
FILESYSTEM_DISK=public

APP_NAME="SPK & Kontrol Keuangan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------
# Database aplikasi (MySQL/MariaDB).
# Siapkan database & user lewat docs/Architecture.md §12.
# ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bks
DB_USERNAME=bks
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------
# OCR nota (opsional). Detail: docs/Architecture.md §14.
# OCR hanya menghitung jumlah nota — nominal diisi admin.
# ---------------------------------------------------------
OCR_NOTA=false
# OCR_NOTA_PYTHON=/path/ke/proyek/ocr-venv/bin/python
# OCR_NOTA_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

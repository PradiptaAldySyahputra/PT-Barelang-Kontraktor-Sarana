APP_NAME="SPK & Kontrol Keuangan"
APP_ENV=local
APP_KEY=
# ⚠️ WAJIB false untuk server (produksi/intranet). true HANYA saat mengembangkan
# di komputer sendiri — kalau true di server, stack trace & struktur DB bisa
# terlihat pengguna saat terjadi error.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------
# Database aplikasi (MySQL/MariaDB).
# Siapkan database & user lewat docs/Architecture.md §12.
# ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bks
DB_USERNAME=bks
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# ⚠️ Set true bila aplikasi diakses lewat HTTPS (mis. di balik reverse proxy).
# Di server lokal intranet (HTTP biasa) biarkan kosong/false — kalau true saat
# HTTP, cookie sesi tidak akan terkirim dan pengguna tidak bisa login.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------
# EMAIL / SMTP — untuk fitur "Lupa Password".
#
# Bawaan `log` = email TIDAK benar-benar dikirim, hanya ditulis ke
# `storage/logs/laravel.log` (cukup untuk pengembangan & uji).
# Agar tautan reset password benar-benar sampai ke kotak masuk pengguna,
# isi konfigurasi SMTP di bawah lalu jalankan `php artisan config:clear`.
#
# Contoh Gmail (perlu "App Password", bukan password biasa):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=nama@gmail.com
#   MAIL_PASSWORD=app-password-16-huruf
#   MAIL_SCHEME=tls
#
# Contoh server kantor / cPanel:
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.namadomain.com
#   MAIL_PORT=465
#   MAIL_USERNAME=no-reply@namadomain.com
#   MAIL_PASSWORD=password-email
#   MAIL_SCHEME=ssl
# ---------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bks.local"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls

# ---------------------------------------------------------
# OCR nota (opsional). Detail: docs/Architecture.md §14.
# OCR hanya menghitung jumlah nota — nominal diisi admin.
# ---------------------------------------------------------
OCR_NOTA=false
# OCR_NOTA_PYTHON=/path/ke/proyek/ocr-venv/bin/python
# OCR_NOTA_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
